# Optional AI rationales (server-side only). Gemini has a free tier: https://aistudio.google.com/apikey
# Provider order: Gemini -> Claude -> deterministic template (used when no key is set).
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional: live execution via Strike builder codes (testnet by default). Leave empty to keep the app in paper mode.
NEXT_PUBLIC_STRIKE_BUILDER_CODE=
NEXT_PUBLIC_STRIKE_ENV=testnet
NEXT_PUBLIC_BUILDER_FEE_BPS=5
